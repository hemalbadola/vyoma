/// API Keys and Secrets Configuration
/// 
/// Copy this file to `secrets.dart` and fill in your API keys.
/// DO NOT commit secrets.dart to version control!
/// 
/// Preferred secure flow:
/// - Do not hardcode keys in `secrets.dart`.
/// - Inject via --dart-define during build.
/// - For production, use a backend proxy for LLM calls.

class Secrets {
  // Google OAuth Client IDs (required for Google Sign-In)
  static const String desktopClientSecret = String.fromEnvironment('VYOMA_DESKTOP_CLIENT_SECRET', defaultValue: '');
  static const String desktopClientId = String.fromEnvironment('VYOMA_DESKTOP_CLIENT_ID', defaultValue: '');
  static const String iOSClientId = String.fromEnvironment('VYOMA_IOS_CLIENT_ID', defaultValue: '');
  static const String androidClientId = String.fromEnvironment('VYOMA_ANDROID_CLIENT_ID', defaultValue: '');

  // Gemini API Keys (get from https://aistudio.google.com/apikey)
  // Use model: gemini-2.5-flash
  static const String _geminiApiKeysRaw =
      String.fromEnvironment('VYOMA_GEMINI_API_KEYS', defaultValue: '');
  static List<String> get geminiApiKeys => _parseCsv(_geminiApiKeysRaw);

  // OpenAI API Keys (get from https://platform.openai.com/api-keys)
  static const List<String> openAiApiKeys = [];

  // Cerebras API Keys (get from https://cerebras.ai)
  static const List<String> cerebrasApiKeys = [];

  // A4F API Keys
  static const List<String> a4fApiKeys = [];
  
  // Perplexity API Keys (get from https://www.perplexity.ai/settings/api)
  static const List<String> perplexityApiKeys = [];

  // OpenRouter API Keys (get from https://openrouter.ai/keys)
  static const List<String> openRouterApiKeys = [];
  static const String openRouterModel = 'meta-llama/llama-3.2-3b-instruct:free';

  // Supermemory API Key
  static const String supermemoryApiKey =
      String.fromEnvironment('VYOMA_SUPERMEMORY_API_KEY', defaultValue: '');

  static List<String> _parseCsv(String rawInput) {
    final raw = rawInput.trim();
    if (raw.isEmpty) return const [];
    return raw
        .split(',')
        .map((e) => e.trim())
        .where((e) => e.isNotEmpty)
        .toList();
  }
}
