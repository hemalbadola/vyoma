rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // 🔥 USERS
    match /users/{userId} {
      allow read: if isAuthenticated(); // Friends need to read profiles
      allow create, update: if isOwner(userId);
      allow delete: if false; // Soft deletes preferred
      
      // Allow user to write to their nested collections (like devices, telemetry)
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // 📛 USERNAMES (Global Index)
    match /usernames/{username} {
      allow read: if isAuthenticated();
      // Allow creation if the username isn't taken and the user is claiming it.
      allow create: if isAuthenticated() && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // 🤝 FRIENDSHIPS
    match /friendships/{friendshipId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.users;
      // Allow creation if the user is one of the users
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.users;
      allow update, delete: if isAuthenticated() && request.auth.uid in resource.data.users;
    }

    // 📈 ACTIVITIES & PACTS
    match /activities/{activityId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    match /pacts/{pactId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      allow update, delete: if isAuthenticated() && request.auth.uid in resource.data.participants;
    }
  }
}
