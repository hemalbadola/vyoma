rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function uidInList(field) {
      return field is list && request.auth.uid in field;
    }

    // ── Config (version gate, remote flags) — client read-only ─────────────
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ── Users + nested owner data (tasks, daily_metrics, devices, …) ───────
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny([
            'subscriptionPlan',
            'subscriptionStatus',
            'subscriptionActiveAt',
            'subscriptionExpiresAt',
            'lastPaymentId',
            'lastOrderId',
            'subscriptionSource',
            'lastCouponCode'
          ]);
      allow delete: if false;

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /usernames/{username} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    match /friendships/{friendshipId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.users;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.users;
      allow update, delete: if isAuthenticated() && request.auth.uid in resource.data.users;
    }

    match /activities/{activityId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /pacts/{pactId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      allow update, delete: if isAuthenticated() && request.auth.uid in resource.data.participants;
    }

    // ── Friend nudges (PingService) ─────────────────────────────────────────
    match /pings/{pingId} {
      allow read: if isAuthenticated() && (
        resource.data.toUid == request.auth.uid ||
        resource.data.fromUid == request.auth.uid
      );
      allow create: if isAuthenticated() &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.toUid != request.auth.uid &&
        request.resource.data.keys().hasAll(['fromUid', 'fromName', 'toUid', 'taskTitle', 'timestamp']);
      allow update, delete: if false;
    }

    // ── Witness vows ───────────────────────────────────────────────────────
    match /vows/{vowId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.witnessUid == request.auth.uid
      );
      allow create: if isAuthenticated() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.witnessUid != request.auth.uid;
      allow update: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
      allow delete: if false;
    }

    // ── Mirror sessions (host + partner only) ───────────────────────────────
    match /mirror_sessions/{sessionId} {
      allow read: if isAuthenticated() && uidInList(resource.data.members);
      allow create: if isAuthenticated() &&
        request.resource.data.hostUid == request.auth.uid &&
        request.resource.data.partnerUid != request.auth.uid &&
        uidInList(request.resource.data.members);
      allow update: if isAuthenticated() && uidInList(resource.data.members);
      allow delete: if false;
    }

    // ── Council (advisors & queries) ─────────────────────────────────────────
    match /council_members/{memberId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.advisorUid == request.auth.uid
      );
      allow create: if isAuthenticated() &&
        request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.advisorUid == request.auth.uid
      );
      allow delete: if false;
    }

    match /payment_records/{paymentId} {
      allow read, write: if false;
    }

    match /promo_codes/{code} {
      allow read, write: if false;

      match /redemptions/{uid} {
        allow read, write: if false;
      }
    }

    match /council_queries/{queryId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        uidInList(resource.data.advisorUids)
      );
      allow create: if isAuthenticated() &&
        request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAuthenticated() && uidInList(resource.data.advisorUids);
      allow delete: if false;
    }
  }
}
